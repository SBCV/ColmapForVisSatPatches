+// NOTE (satellite fork): the RPC-approximated cameras put the principal point
+// hundreds of image widths outside the image, so the fourth column of P is a
+// difference of near-equal large terms. Composing the float mirror from float
+// inputs loses ~1e-5 relative there; composing in double and rounding once
+// keeps it at float32 storage precision, ~1e-8. Constants are the worst real
+// MVS3DM site 1 camera scaled to cancel by ~900x in P[3] and ~2000x in P[7].
+TEST(Image, FloatMirrorComposedInDouble) {
+  const double fx = 4223082.0;
+  const double fy = 3875869.0;
+  const double cx = 20842.8;
+  const double cy = 1627083.1;
+  const double tx = -7345.6460439713619;
+  const double ty = -625186.67222511908;
+  const double tz = 1490000.0;
+
+  const double K[9] = {fx, 0, cx, 0, fy, cy, 0, 0, 1};
+  const double R[9] = {1, 0, 0, 0, 1, 0, 0, 0, 1};
+  const double T[3] = {tx, ty, tz};
+
+  const Image image("test.jpg", 2276, 2132, K, R, T);
+  const float* P = image.GetP();
+
+  // R is the identity, so these are the exact values of the fourth column.
+  const double expected_03 = fx * tx + cx * tz;
+  const double expected_13 = fy * ty + cy * tz;
+
+  EXPECT_LT(std::abs(P[3] - expected_03) / std::abs(expected_03), 1e-6);
+  EXPECT_LT(std::abs(P[7] - expected_13) / std::abs(expected_13), 1e-6);
+}

+CeresBundleAdjustmentOptions::CreateConstrainPointsLossFunction() const {
+  // Reuse the upstream per-type factory and apply the constrain-points
+  // weight on top.
+  return std::make_unique<ceres::ScaledLoss>(
+      ::colmap::CreateLossFunction(constrain_points_loss,
+                                   constrain_points_loss_scale)
+          .release(),
+      constrain_points_loss_weight,

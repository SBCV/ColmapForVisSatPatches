+  // add constrained point to problem
+  void AddConstrainedPointToProblem(const point3D_t point3D_id,
+                                    Reconstruction& reconstruction) {
+    Point3D& point3D = reconstruction.Point3D(point3D_id);
+    // Since the e165728d cost-function modularization, upstream's
+    // NormalPriorCostFunctor<3> (residual = param - prior) is an exact
